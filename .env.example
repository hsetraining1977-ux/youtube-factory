# ════════════════════════════════════════════════
# Multi-Channel Factory — API Keys
# Copy this file to .env and fill in your keys
# ════════════════════════════════════════════════

# 1. ANTHROPIC (Claude for scripts)
#    Get at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# 2. ELEVENLABS (Voice narration)
#    Get at: https://elevenlabs.io → Profile → API Keys
#    Starter plan ($5/mo) is enough for testing
ELEVENLABS_API_KEY=...

# 3. OPENAI (DALL-E 3 for thumbnails)
#    Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# 4. PEXELS (FREE stock footage)
#    Get at: https://www.pexels.com/api/ → free account
PEXELS_API_KEY=...

# 5. YOUTUBE (OAuth — set up separately per channel)
#    See GUIDE.md → YouTube Setup
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
